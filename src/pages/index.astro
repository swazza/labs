---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout description="Notes and experiments on systems, databases, performance and software architecture.">
  {posts.length === 0 ? (
    <p>Nothing here yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <a href={`${base}/posts/${post.id}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  )}
</Layout>
